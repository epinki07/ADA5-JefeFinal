{
  "name": "ada5-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "containers": [
    {
      "class_name": "Ada5Api",
      "image": "../../backend/Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ADA5_API", "class_name": "Ada5Api" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ada5Api"] }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
